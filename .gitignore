# ---- Runtime artefacts (never commit user data) ----------------------------
# A docking run copies the user's files into workspace/<timestamp>/; those are
# the user's data, not part of the project.
workspace/
logs/
*.log
*.tmp
*.bak
*.orig
*.rej

# ---- Packaging -------------------------------------------------------------
# PyInstaller writes the bundle and its workpath here.
dist/
*.spec
*.manifest

