# Line endings are part of the contract for a few files here, so they are
# pinned instead of left to whatever core.autocrlf each checkout happens to
# use.  Without this, a Windows box (where Git defaults to autocrlf=true)
# turns every LF into CRLF on checkout and:
#
#   *.sh / *.command  -> dies on macOS with
#                        "syntax error near unexpected token"
#   *.bat             -> cmd.exe mishandles its :need subroutine with lone LF
#   HOW-TO-RUN.txt    -> must reach Notepad as CRLF *with* a UTF-8 BOM
#   HOW-TO-RUN-mac.txt-> must stay pure LF
#
# Everything else (.py, .md, .toml, ...) is newline-agnostic; LF everywhere
# keeps the repository identical no matter who checks it out.

* text=auto eol=lf

# macOS shell - LF only, everywhere.
*.sh        text eol=lf
*.command   text eol=lf

# Windows batch - CRLF only, everywhere.
*.bat       text eol=crlf

# The two receiver notes are line-ending specific, and the BOM on the
# Windows one is what stops Notepad from showing mojibake.
packaging/HOW-TO-RUN.txt      text eol=crlf
packaging/HOW-TO-RUN-mac.txt  text eol=lf

# plistlib reads either, but LF keeps the file byte-identical to the one
# that was reviewed.
packaging/enzydock.entitlements text eol=lf
